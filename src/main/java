package com.apps.quantitymeasurement;

public class QuantityMeasurementApp {

    // -------------------- ENUM --------------------
    public enum LengthUnit {
        FEET(1.0),
        INCH(1.0 / 12.0),
        YARD(3.0),
        CENTIMETER(0.393701 / 12.0);

        private final double toFeetFactor;

        LengthUnit(double toFeetFactor) {
            this.toFeetFactor = toFeetFactor;
        }

        public double toFeet(double value) {
            return value * toFeetFactor;
        }

        public double fromFeet(double valueInFeet) {
            return valueInFeet / toFeetFactor;
        }
    }

    // -------------------- QUANTITY CLASS --------------------
    public static class Quantity {
        private final double value;
        private final LengthUnit unit;

        public Quantity(double value, LengthUnit unit) {
            if (unit == null) throw new IllegalArgumentException("Unit cannot be null");
            if (!Double.isFinite(value)) throw new IllegalArgumentException("Invalid value");

            this.value = value;
            this.unit = unit;
        }

        // -------- EQUALITY --------
        @Override
        public boolean equals(Object obj) {
            if (this == obj) return true;
            if (obj == null) return false;
            if (this.getClass() != obj.getClass()) return false;

            Quantity other = (Quantity) obj;

            double thisFeet = this.unit.toFeet(this.value);
            double otherFeet = other.unit.toFeet(other.value);

            return Double.compare(thisFeet, otherFeet) == 0;
        }

        // -------- CONVERSION --------
        public Quantity convertTo(LengthUnit target) {
            double feet = this.unit.toFeet(this.value);
            double converted = target.fromFeet(feet);
            return new Quantity(converted, target);
        }

        // -------- ADDITION UC6 (same unit as first operand) --------
        public Quantity add(Quantity other) {
            return add(other, this.unit);
        }

        // -------- ADDITION UC7 (explicit target unit) --------
        public Quantity add(Quantity other, LengthUnit targetUnit) {
            if (other == null) throw new IllegalArgumentException("Other cannot be null");
            if (targetUnit == null) throw new IllegalArgumentException("Target unit cannot be null");

            double thisFeet = this.unit.toFeet(this.value);
            double otherFeet = other.unit.toFeet(other.value);

            double sumFeet = thisFeet + otherFeet;

            double resultValue = targetUnit.fromFeet(sumFeet);

            return new Quantity(resultValue, targetUnit);
        }

        @Override
        public String toString() {
            return value + " " + unit;
        }
    }

    // -------------------- STATIC METHODS --------------------

    public static double convert(double value, LengthUnit from, LengthUnit to) {
        if (from == null || to == null) throw new IllegalArgumentException("Units cannot be null");
        if (!Double.isFinite(value)) throw new IllegalArgumentException("Invalid value");

        double feet = from.toFeet(value);
        return to.fromFeet(feet);
    }

    public static Quantity add(Quantity q1, Quantity q2) {
        return q1.add(q2);
    }

    public static Quantity add(Quantity q1, Quantity q2, LengthUnit target) {
        return q1.add(q2, target);
    }

    // -------------------- DEMO METHODS --------------------

    public static void demonstrateAddition(Quantity q1, Quantity q2) {
        System.out.println("Add (default) " + q1 + " + " + q2 + " = " + q1.add(q2));
    }

    public static void demonstrateAddition(Quantity q1, Quantity q2, LengthUnit target) {
        System.out.println("Add (target=" + target + ") " + q1 + " + " + q2 + " = " + q1.add(q2, target));
    }

    // -------------------- MAIN --------------------
    public static void main(String[] args) {

        System.out.println("----- UC7: ADDITION WITH TARGET UNIT -----");

        Quantity f1 = new Quantity(1.0, LengthUnit.FEET);
        Quantity i12 = new Quantity(12.0, LengthUnit.INCH);
        Quantity y1 = new Quantity(1.0, LengthUnit.YARD);
        Quantity f3 = new Quantity(3.0, LengthUnit.FEET);

        // -------- UC6 (default) --------
        demonstrateAddition(f1, i12);

        // -------- UC7 (explicit target unit) --------
        demonstrateAddition(f1, i12, LengthUnit.FEET);
        demonstrateAddition(f1, i12, LengthUnit.INCH);
        demonstrateAddition(f1, i12, LengthUnit.YARD);

        demonstrateAddition(y1, f3, LengthUnit.YARD);
        demonstrateAddition(new Quantity(36.0, LengthUnit.INCH), y1, LengthUnit.FEET);

        demonstrateAddition(new Quantity(2.54, LengthUnit.CENTIMETER),
                            new Quantity(1.0, LengthUnit.INCH),
                            LengthUnit.CENTIMETER);

        // -------- EDGE CASES --------
        demonstrateAddition(new Quantity(5.0, LengthUnit.FEET),
                            new Quantity(0.0, LengthUnit.INCH),
                            LengthUnit.YARD);

        demonstrateAddition(new Quantity(5.0, LengthUnit.FEET),
                            new Quantity(-2.0, LengthUnit.FEET),
                            LengthUnit.INCH);
    }
}